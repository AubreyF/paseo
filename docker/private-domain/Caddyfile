{
	admin off
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

https://{$PUBLIC_HOSTNAME}:8443 {
	bind 127.0.0.1
	encode zstd gzip
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	reverse_proxy https://{$UPSTREAM_HOST}:{$UPSTREAM_PORT} {
		header_up Host {host}
		transport http {
			tls_server_name {$UPSTREAM_HOST}
			dial_timeout 10s
			response_header_timeout 30s
		}
	}
}
