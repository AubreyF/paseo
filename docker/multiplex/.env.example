# install.sh generates .env with an image digest, unique instance name and password.
PASEO_IMAGE=paseo-multiplex:review
PASEO_INSTANCE=replace-with-unique-instance-name
PASEO_PASSWORD=replace-with-random-password
PASEO_DATA_ROOT=./data
PASEO_WORKSPACE_ROOT=./workspace
# Optional limits and host inference credential.
PASEO_MEMORY_LIMIT=16g
PASEO_MEMORY_SWAP_LIMIT=20g
PASEO_CPU_LIMIT=4
MTPLX_API_KEY=
