PASEO_IMAGE=ghcr.io/aubreyf/paseo-multiplex:edge
PASEO_INSTANCE=paseo-personal
PASEO_DATA_ROOT=./data
PASEO_MEMORY_LIMIT=16g
PASEO_MEMORY_SWAP_LIMIT=20g
PASEO_CPU_LIMIT=4
PASEO_PASSWORD=replace-with-a-long-random-password
PASEO_PORT=6767
PASEO_WORKSPACE_ROOT=./workspace
PASEO_HOSTNAMES=
# Runtime-only credential for the optional host inference service.
MTPLX_API_KEY=
